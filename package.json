{
  "name": "pqq-thi-online",
  "version": "1.0.0",
  "private": true,
  "description": "PQQ Thi Online — test runner & deployment scripts",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js tests/security/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "test:sync": "node scripts/test-sync.js",
    "test:quota": "node scripts/quota-stress-test.js",
    "verify:polling": "node scripts/verify-polling-config.js",
    "seed": "node scripts/seed-demo.js",
    "bundle:usb": "bash scripts/bundle-usb.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
